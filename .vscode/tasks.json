{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LTM: 编译例程 (basic/ra6m4)",
            "type": "shell",
            "command": "D:/GoodThing/Python/python.exe",
            "args": [
                "${workspaceFolder}/examples/basic/script.py",
                "-b"
            ],
            "options": {
                "cwd": "${workspaceFolder}/examples/basic",
                "env": {
                    "PYTHONIOENCODING": "utf-8"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "LTM: 编译+烧录 (basic/ra6m4)",
